{
  "name": "allku-pet-core",
  "version": "0.1.0",
  "private": true,
  "description": "ALLKU-PET Core - modular monolith with hexagonal architecture",
  "license": "UNLICENSED",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "architecture": "depcruise src --config dependency-cruiser.cjs",
    "quality": "npm run typecheck && npm run lint && npm run format && npm run architecture && npm run test:coverage && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.16.2",
    "fastify": "^5.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/node": "^22.18.6",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^17.1.0",
    "eslint": "^9.36.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
